#!/bin/sh
# Zwei Waechter — jeder prueft NUR, wenn vorgemerkte Dateien ihn betreffen:
#   1. IFC: Client-Woerterbuch == Schema-Schnappschuss, docs/ifc == Code (backend/app/ifc/README.md)
#   2. isybau: das Token-System von client/src/features/isybau (stylelint)
#
# Prueft NUR die vorgemerkten Dateien, nicht den ganzen Baum - ein Commit an
# einem anderen Feature soll nicht an isybau haengenbleiben.
#
# Aktivieren:   git config core.hooksPath .githooks
# Umgehen:      git commit --no-verify   (fuer den einen Notfall, nicht als Gewohnheit)

# ── 1. IFC (Fahrplan IFC-Konsistenz, Stufe 8) ─────────────────────────────
# Die Dateien in client/src/features/cde/data/ sind ERZEUGT. Ein Commit, der die
# Schema-Wahrheit oder die erzeugten Dateien aendert, muss beide gleich halten.
# Geprueft wird der Arbeitsbaum — wie beim isybau-Block unten.
ifc=$(git diff --cached --name-only --diff-filter=ACMD \
      | grep -E '^(backend/app/ifc/|client/src/features/cde/(data/|services/(bauform/Typprofile|Bauteilrezepte|GelaendeQuelle|Kategorien)\.js)|docs/ifc/)' || true)
if [ -n "$ifc" ]; then
    (cd backend && python3 -m app.ifc.generiere_client --pruefe) || {
        echo "" >&2
        echo "pre-commit: Client-Woerterbuch weicht vom Schema-Schnappschuss ab." >&2
        echo "  neu erzeugen:  (cd backend && python3 -m app.ifc.generiere_client) && git add client/src/features/cde/data" >&2
        exit 1
    }
    (cd backend && python3 -m app.ifc.diagramme --pruefe) || {
        echo "" >&2
        echo "pre-commit: docs/ifc weicht vom Code ab." >&2
        echo "  neu erzeugen:  (cd backend && python3 -m app.ifc.diagramme) && git add docs/ifc" >&2
        exit 1
    }
fi

# ── 2. isybau ─────────────────────────────────────────────────────────────
dateien=$(git diff --cached --name-only --diff-filter=ACM \
          | grep -E '^client/src/features/isybau/.*\.(vue|css)$' || true)
[ -z "$dateien" ] && exit 0

if [ ! -x client/node_modules/.bin/stylelint ]; then
    echo "pre-commit: stylelint fehlt." >&2
    echo "  npm --prefix client install -D stylelint postcss-html" >&2
    exit 1
fi

# Pfade relativ zu client/, weil dort die Konfiguration liegt.
rel=$(echo "$dateien" | sed 's|^client/||')
# shellcheck disable=SC2086
(cd client && ./node_modules/.bin/stylelint $rel) || {
    echo "" >&2
    echo "pre-commit: rohe Werte statt Tokens. Siehe client/.stylelintrc.json." >&2
    echo "  Farben     -> var(--isy-pixel-*)   in styles/theme.css" >&2
    echo "  Schrift    -> var(--isy-fs-*)      6 Stufen" >&2
    echo "  Abstaende  -> var(--isy-space-1..7) Vielfache von 4" >&2
    echo "  Radien     -> var(--isy-radius-*)  3 Stufen" >&2
    echo "  z-index    -> var(--isy-z-*)       5 Ebenen, Staffelung per calc()" >&2
    exit 1
}
exit 0
