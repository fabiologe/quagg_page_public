/*--------------------------------*- C++ -*----------------------------------*\
|  Erzeugt von quagg flood3D casebuilder — nicht von Hand bearbeiten,         |
|  maßgeblich ist die casespec (Spez. Kap. 4.1).                              |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    atmosphere
    {
        type            calculated;
        value           uniform 0;
    }
    terrain
    {
        type            nutkRoughWallFunction;
        Ks              uniform 0.03;
        Cs              uniform 0.5;
        value           uniform 0;
    }
    ".*"
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
}

// ************************************************************************* //
