+	// QUAGG outflow-direction: die NoData-Zelle, in die eine Punkt-FREE-Zelle (FREE9, oben)
+	// entwaessert, existiert im Array (anders als am echten Rasterrand, wo "jenseits der Kante"
+	// gar kein Array-Slot mehr ist) -- die Divergenz-Schleife oben schreibt ihr per
+	// (*hptr)+=dV/dA DASSELBE Wasser gut, das der Quellzelle gerade abgezogen wurde. DomainVol()
+	// (util.cpp) summiert H ueber ALLE Zellen ohne NoData-Ausschluss (nur ChanMask-Filter) --
+	// ohne diesen Reset "verschwindet" das Wasser also gar nicht aus der Bilanz, es wandert nur
+	// eine Zelle weiter (verifiziert: Tiefe an der Quellzelle sinkt korrekt, aber Vol/Verror
+	// zeigen keinen echten Abfluss, 2026-07-23). Fix: die Empfaenger-Zelle NACH der Divergenz-
+	// Schleife hart auf 0 zuruecksetzen -- sie ist NoData (DEM=nodata_elevation, riesiger
+	// Sentinel-Wert), bekommt aus keiner anderen Quelle je sinnvollen Zufluss (deren hflow
+	// kollabiert dort ohnehin auf ~0, s. CalcFPQxAcc/CalcFPQyAcc), daher unschaedlich fuer jede
+	// andere Physik. Recompute der Nachbarzelle ist bewusst dieselbe Fallunterscheidung wie oben
+	// (kein State zwischen den beiden Schleifen noetig, reine Index-Arithmetik).
+	for (int ps_index = 0; ps_index<BCptr->numPS; ps_index++)
+	{
+		if (BCptr->PS_Ident[ps_index] != FREE9) continue;
+		if (!(Statesptr->acceleration == ON && Statesptr->SGC == OFF)) continue;
+
+		int xi = BCptr->xpi[ps_index];
+		int yi = BCptr->ypi[ps_index];
+		int pOut = -1;
+		switch (BCptr->PS_Dir[ps_index])
+		{
+			case North: if (yi - 1 >= 0)             pOut = xi + (yi - 1) * Parptr->xsz; break;
+			case South: if (yi + 1 < Parptr->ysz)     pOut = xi + (yi + 1) * Parptr->xsz; break;
+			case East:  if (xi + 1 < Parptr->xsz)     pOut = (xi + 1) + yi * Parptr->xsz; break;
+			case West:  if (xi - 1 >= 0)              pOut = (xi - 1) + yi * Parptr->xsz; break;
+			default: continue;
+		}
+		if (pOut >= 0) Arrptr->H[pOut] = C(0.0);
+	}
