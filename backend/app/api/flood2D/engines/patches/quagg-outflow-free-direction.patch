+	// QUAGG outflow-direction: Punkt-FREE mit expliziter Austrittskante (fuer Zellen, die die
+	// literale Rechteck-Kante nirgends erreichen -- z. B. ein schiefes/rotiertes DGM, dessen
+	// wahre Kante diagonal durchs Raster laeuft). Nutzt DIESELBE Manning-Normalabfluss-Formel
+	// wie eine native Kanten-FREE-Zeile (boundary.cpp, FREE1/acceleration), nur auf der Kante
+	// DIESER Zelle in der angegebenen Richtung statt am Rasterrand. MUSS VOR der Divergenz-
+	// Schleife unten stehen (anders als der inflow-momentum-Block weiter unten, der bewusst
+	// NACH ihr steht) -- FREE muss DIESEN Zeitschritt Volumen abfuehren, nicht nur die naechste
+	// Reibungs-Rueckkopplung beeinflussen (die native Kanten-FREE laeuft in BCs() ebenfalls VOR
+	// UpdateH: Reihenfolge pro Zeitschritt ist FloodplainQ -> BCs -> UpdateH -> UpdateQs).
+	for (int ps_index = 0; ps_index<BCptr->numPS; ps_index++)
+	{
+		if (BCptr->PS_Ident[ps_index] != FREE9) continue;
+		if (!(Statesptr->acceleration == ON && Statesptr->SGC == OFF)) continue;
+
+		int xi = BCptr->xpi[ps_index];
+		int yi = BCptr->ypi[ps_index];
+		int p0 = xi + yi * Parptr->xsz;
+		if (Arrptr->ChanMask[p0] != -1) continue; // kein natives Kanalsegment hier (wie boundary.cpp)
+		NUMERIC_TYPE h0 = Arrptr->H[p0];
+		if (h0 <= Solverptr->DepthThresh) continue; // Wet-Gate (wie boundary.cpp FREE1)
+		NUMERIC_TYPE hflow = h0; // wie boundary.cpp: hflow = die eigene Tiefe der Austrittszelle
+		NUMERIC_TYPE fn = (Arrptr->Manningsn != NULL) ? Arrptr->Manningsn[p0] : Parptr->FPn;
+
+		int xsz1 = Parptr->xsz + 1;
+		NUMERIC_TYPE *qptr, *qoldptr;
+		int sign;
+		int p1 = -1; // "rueckwaertiger" Nachbar (tiefer im gueltigen Gelaende), nur fuer Auto-Sf
+		switch (BCptr->PS_Dir[ps_index])
+		{
+			case North:
+				qptr = Arrptr->Qy + (xi + yi*xsz1); qoldptr = Arrptr->Qyold + (xi + yi*xsz1);
+				sign = -1;
+				if (yi + 1 < Parptr->ysz) p1 = xi + (yi + 1) * Parptr->xsz;
+				break;
+			case South:
+				qptr = Arrptr->Qy + (xi + (yi + 1)*xsz1); qoldptr = Arrptr->Qyold + (xi + (yi + 1)*xsz1);
+				sign = 1;
+				if (yi - 1 >= 0) p1 = xi + (yi - 1) * Parptr->xsz;
+				break;
+			case East:
+				qptr = Arrptr->Qx + (xi + 1 + yi*xsz1); qoldptr = Arrptr->Qxold + (xi + 1 + yi*xsz1);
+				sign = 1;
+				if (xi - 1 >= 0) p1 = (xi - 1) + yi * Parptr->xsz;
+				break;
+			case West:
+				qptr = Arrptr->Qx + (xi + yi*xsz1); qoldptr = Arrptr->Qxold + (xi + yi*xsz1);
+				sign = -1;
+				if (xi + 1 < Parptr->xsz) p1 = (xi + 1) + yi * Parptr->xsz;
+				break;
+			default:
+				continue; // input.cpp erzeugt FREE9 nur bei N/E/S/W -- sollte nie eintreten
+		}
+
+		NUMERIC_TYPE Sf;
+		if (BCptr->PS_Val[ps_index] < C(-0.999)) // -1 = kein Gefaelle angegeben -> aus DEM-Gefaelle (wie boundary.cpp)
+		{
+			if (p1 >= 0)
+			{
+				NUMERIC_TYPE h1 = Arrptr->H[p1], z1 = Arrptr->DEM[p1];
+				NUMERIC_TYPE dh = Arrptr->DEM[p0] + h0 - z1 - h1;
+				Sf = -dh / Parptr->dx;
+			}
+			else Sf = C(0.001); // kein rueckwaertiger Nachbar (Zelle am aeussersten Rand) -> flaches Sicherheitsgefaelle statt Absturz
+		}
+		else Sf = BCptr->PS_Val[ps_index]; // vom Nutzer vorgegebenes Sohlgefaelle
+
+		NUMERIC_TYPE q0 = *qoldptr;
+		*qoldptr = (NUMERIC_TYPE)sign * (FABS(q0) + FABS(Solverptr->g*Solverptr->Tstep*hflow*Sf))
+		           / (1 + Solverptr->g*Solverptr->Tstep*hflow*fn*fn*FABS(q0) / (pow(hflow, (C(10.) / C(3.)))));
+		*qptr = *qoldptr * Parptr->dx; // wie boundary.cpp (Kommentar dort: potenziell redundant zu UpdateQs, unveraendert uebernommen)
+
+		// QUAGG: in die Massebilanz eintragen (wie QFIX4/QVAR5 oben) -- ohne dies entfernt der
+		// Divergenz-Schritt zwar tatsaechlich Wasser aus der Zelle (Qx/Qy wird von der Schleife
+		// unten korrekt gelesen), aber BoundaryFlux() (boundary.cpp) berechnet Qout NUR aus den
