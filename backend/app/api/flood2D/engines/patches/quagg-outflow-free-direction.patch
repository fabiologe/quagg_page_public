+		// Eintrag bliebe in res.mass' Qout-Spalte unsichtbar (verifiziert: echter, gemessener
+		// Tiefenrueckgang an der Zelle, aber Qout=0.000 durchgehend, 2026-07-23).
+		BCptr->Qpoint_neg += -FABS(*qptr);
+	}
+
