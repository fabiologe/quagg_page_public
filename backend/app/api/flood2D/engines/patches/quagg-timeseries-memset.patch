 #include <vector> // CCS
+#include <deque> // QUAGG-FIX5: allTimeSeries needs stable references across push_back, see below
+#include <new> // QUAGG-FIX5: placement-new to re-construct allTimeSeries after memset(), see lisflood.cpp
 #include <iostream> // CCS
 //#include <netcdf.h> // JCN
 
@@ -468,7 +470,16 @@
 	NUMERIC_TYPE VolInMT; // added by JCN stores volume in over mass inteval
 	NUMERIC_TYPE VolOutMT; // added by JCN stores volume out over mass inteval
 
-	std::vector<TimeSeries> allTimeSeries;
+	// QUAGG-FIX5: was std::vector<TimeSeries>. input.cpp's LoadBCVar() takes a reference to
+	// allTimeSeries.back() right after each push_back and stores that ADDRESS into
+	// BC_TimeSeries[]/PS_TimeSeries[] for later use every timestep. A vector can reallocate
+	// its whole backing buffer on push_back, silently invalidating every reference taken on
+	// an earlier iteration -- with 2+ .bdy profiles this reliably produces dangling pointers,
+	// segfaulting later in InterpolateTimeSeries() (observed: real job, Exit -11/SIGSEGV, see
+	// engines/patches/README.md). deque never invalidates references to existing elements on
+	// push_back/pop_back at the ends (only vector does) -- exactly the guarantee needed here,
+	// same push_back/back()/pop_back() interface, drop-in replacement.
+	std::deque<TimeSeries> allTimeSeries;
 };
 
