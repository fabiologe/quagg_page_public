+	// QUAGG inflow-momentum: gerichteter Zufluss MIT Impuls an einer (Innen-)Zelle.
+	// Setzt den Kantenfluss Qx/Qy in Fliessrichtung; UpdateQs kopiert ihn danach nach
+	// Qxold/Qyold, sodass der Traegheits-Solver (fp_acc) ihn im naechsten Schritt als q0
+	// weitertraegt. WICHTIG: NACH der Divergenz-Schleife oben (sonst Massenfehler) und
+	// in Qx/Qy-EINHEITEN (m3/s = m2/s*dx, denn UpdateQs teilt durch dx). Sicherheits-Design
+	// (siehe patches/README.md):
+	//  - nur wenn Fliessrichtung gesetzt (sonst Legacy/Volumen-only),
+	//  - nur acceleration-Solver & SGC AUS (sonst Flux-Arrays anders/unbenutzt),
+	//  - Wet-Gate h>DepthThresh (sonst erst Volumen aufbauen; verhindert 0/0),
+	//  - Froude-Kappung |v|<=sqrt(g*h) ⇒ injizierte Geschwindigkeit <= Wellengeschw.,
+	//    womit die tiefenbasierte CFL gueltig bleibt,
+	//  - ADD-then-clamp ⇒ gegenlaeufige/serielle Zulaeufe bleiben beschraenkt.
+	for (int ps_index = 0; ps_index<BCptr->numPS; ps_index++)
+	{
+		if (BCptr->PS_Dir[ps_index] == DirectionNA) continue;
+		if (!(BCptr->PS_Ident[ps_index] == QFIX4 || BCptr->PS_Ident[ps_index] == QVAR5)) continue;
+		if (!(Statesptr->acceleration == ON && Statesptr->SGC == OFF)) continue;
+
+		int xi = BCptr->xpi[ps_index];
+		int yi = BCptr->ypi[ps_index];
+		int p  = xi + yi * Parptr->xsz;
+		NUMERIC_TYPE h = Arrptr->H[p];
+		if (h <= Solverptr->DepthThresh) continue; // Wet-Gate
+
+		NUMERIC_TYPE q_user = (BCptr->PS_Ident[ps_index] == QVAR5)
+			? InterpolateTimeSeries(BCptr->PS_TimeSeries[ps_index], Solverptr->t)
+			: BCptr->PS_Val[ps_index];
+		q_user = FABS(q_user); // m2/s; Vorzeichen kommt aus der Richtung
+		NUMERIC_TYPE q_crit = sqrt(Solverptr->g * h) * h;      // kritischer Einheitsabfluss (m2/s)
+		NUMERIC_TYPE q_in = getmin(q_user, q_crit);
+		// in Qx/Qy-Einheiten (m3/s): mit dx multiplizieren (UpdateQs teilt wieder durch dx)
+		NUMERIC_TYPE Q_in  = q_in   * Parptr->dx;
+		NUMERIC_TYPE Q_cap = q_crit * Parptr->dx;
+
+		int xsz1 = Parptr->xsz + 1;
+		// FREIER WINKEL: Welt-Azimut theta (0=Ost, 90=Nord, CCW) in Qx/Qy zerlegen.
+		// Konvention (T1-verifiziert): +Qx=Ost, +Qy=Sued ⇒ Nord = -Qy.
+		//   x-Komponente qx = q*cos(theta)  (+ = ostwaerts)
+		//   y-Komponente qy = -q*sin(theta) (+ = suedwaerts, Nord = negativ)
+		// Jede Komponente wird auf ihre VORDERKANTE (in Komponenten-Richtung) injiziert:
+		// ostwaerts→Ostkante Qx[xi+1], westwaerts→Westkante Qx[xi];
+		// nordwaerts→Nordkante Qy[xi], suedwaerts→Suedkante Qy[xi+(yi+1)]. So liegt der
+		// Impuls immer auf der OFFENEN Vorderkante (nicht auf einer Rueck-/Flankenwand,
+		// die als hohes Wehr gebaut wird) und wirkt konsistent vorwaerts.
+		// Jede Komponente EINZELN Froude-gekappt (ADD-then-clamp) ⇒ Resultierende stabil.
+		NUMERIC_TYPE theta = BCptr->PS_Angle[ps_index] * (NUMERIC_TYPE)(3.14159265358979323846 / 180.0);
+		if (theta != theta) // NaN-Schutz: Winkel nicht gesetzt → kein Impuls
+			continue;
+		NUMERIC_TYPE qx_comp =  cos(theta) * Q_in; // + = ostwaerts
+		NUMERIC_TYPE qy_comp = -sin(theta) * Q_in; // + = suedwaerts (Nord = negativ)
+		const NUMERIC_TYPE QEPS = (NUMERIC_TYPE)1e-9;
+
+		if (FABS(qx_comp) > QEPS)
+		{
+			int xedge = (qx_comp >= C(0.0)) ? (xi + 1 + yi * xsz1)  // Ostkante (vorwaerts)
+			                                : (xi     + yi * xsz1); // Westkante (vorwaerts)
+			NUMERIC_TYPE qnet = Arrptr->Qx[xedge] + qx_comp;
+			if (qnet >  Q_cap) qnet =  Q_cap;
+			if (qnet < -Q_cap) qnet = -Q_cap;
+			Arrptr->Qx[xedge] = qnet;
+		}
+		if (FABS(qy_comp) > QEPS)
+		{
+			int yedge = (qy_comp <= C(0.0)) ? (xi + yi       * xsz1)  // Nordkante (vorwaerts)
+			                                : (xi + (yi + 1) * xsz1); // Suedkante (vorwaerts)
+			NUMERIC_TYPE qnet = Arrptr->Qy[yedge] + qy_comp;
+			if (qnet >  Q_cap) qnet =  Q_cap;
+			if (qnet < -Q_cap) qnet = -Q_cap;
+			Arrptr->Qy[yedge] = qnet;
+		}
+	}
+
 	// Point source HVAR and HFIX
 	for (int ps_index = 0; ps_index<BCptr->numPS; ps_index++)
 	{
