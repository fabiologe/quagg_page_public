+// QUAGG inflow-momentum: optionalen Richtungs-Token eines Punktquellen-Zuflusses parsen.
+// Token kann sein: Himmelsrichtung (N/E/S/W) ODER ein freier Welt-Azimut in Grad
+// (0=Ost, 90=Nord, CCW). Setzt *angle_out (Grad) und gibt das passende EDirection-Enum
+// zurueck (DirectionNA bei leer/unbekannt => Legacy, kein Impuls). Die Richtung ist die
+// FLIESSRICHTUNG, in die das Wasser die Quellzelle verlaesst.
+static EDirection ParseInflowDir(const char *tok, NUMERIC_TYPE *angle_out)
+{
+	*angle_out = (NUMERIC_TYPE)NAN;
+	if (tok == NULL || tok[0] == '\0') return DirectionNA;
+	if (!STRCMPi(tok, "N") || !STRCMPi(tok, "North")) { *angle_out = C(90.0);  return North; }
+	if (!STRCMPi(tok, "E") || !STRCMPi(tok, "East"))  { *angle_out = C(0.0);   return East; }
+	if (!STRCMPi(tok, "S") || !STRCMPi(tok, "South")) { *angle_out = C(270.0); return South; }
+	if (!STRCMPi(tok, "W") || !STRCMPi(tok, "West"))  { *angle_out = C(180.0); return West; }
+	// freier Winkel in Grad?
+	double deg;
+	if (sscanf(tok, "%lf", &deg) == 1)
+	{
+		*angle_out = (NUMERIC_TYPE)deg;
+		return North; // Nicht-NA-Marker; die echte Richtung steckt im Winkel (PS_Dir nur != NA)
+	}
+	return DirectionNA;
+}
